#!/usr/bin/env python3
"""Throwaway launcher. Run ./spike; no plugins, downloads, or user config."""
import json
import os
from pathlib import Path
import shutil
import signal
import subprocess
import sys
import tempfile
import time


def interrupted(_sig, _frame):
    raise KeyboardInterrupt


def owned(pid, token):
    result = subprocess.run(
        ["ps", "-p", str(pid), "-o", "args="], capture_output=True, text=True
    )
    return result.returncode == 0 and token in result.stdout and "fixture.py" in result.stdout


def cleanup(root, token):
    # Only signal fixture PIDs that still identify this exact invocation.
    pids = set()
    for path in root.glob("agent-*.json"):
        try:
            state = json.loads(path.read_text())
            pids.update(p for p in (state.get("pid"), state.get("child")) if p)
        except (OSError, ValueError):
            pass
    for sig in (signal.SIGTERM, signal.SIGKILL):
        for pid in pids:
            if owned(pid, token):
                try:
                    os.kill(pid, sig)
                except ProcessLookupError:
                    pass
        if sig == signal.SIGTERM:
            time.sleep(0.15)


def main():
    signal.signal(signal.SIGTERM, interrupted)
    signal.signal(signal.SIGHUP, interrupted)
    nvim = shutil.which("nvim")
    if not nvim:
        print("This spike needs Neovim 0.11+ and Python 3 on PATH.", file=sys.stderr)
        return 1
    source = Path(__file__).resolve().parent / "spikes" / "native-sessions"
    sys.path.insert(0, str(source))
    arguments = sys.argv[1:]
    live = "--drudwyn" in arguments
    configuration = None
    if live:
        arguments.remove("--drudwyn")
        from pilot import sessions
        configuration = {"sessions": sessions()}
    root = Path(tempfile.mkdtemp(prefix="ai-nvim-spike-"))
    token = root.name
    env = dict(os.environ)
    for key in ("XDG_CONFIG_HOME", "XDG_DATA_HOME", "XDG_STATE_HOME", "XDG_CACHE_HOME", "NVIM_APPNAME"):
        env.pop("AINVIM_ORIGINAL_" + key, None)
        if key in env:
            env["AINVIM_ORIGINAL_" + key] = env[key]
    env.pop("AINVIM_REAL_CONFIG", None)
    if configuration:
        config_path = root / "pilot.json"
        config_path.write_text(json.dumps(configuration))
        env["AINVIM_REAL_CONFIG"] = str(config_path)
    for key in ("CONFIG", "DATA", "STATE", "CACHE"):
        path = root / key.lower()
        path.mkdir()
        env[f"XDG_{key}_HOME"] = str(path)
    env.update(
        NVIM_APPNAME="ai-nvim-spike",
        AINVIM_SPIKE_ROOT=str(root),
        AINVIM_SPIKE_SOURCE=str(source),
        AINVIM_SPIKE_PYTHON=sys.executable,
        AINVIM_SPIKE_TOKEN=token,
        NVIM_LOG_FILE=str(root / "nvim.log"),
    )
    for key in ("NVIM", "NVIM_LISTEN_ADDRESS", "VIMINIT", "EXINIT", "LUA_INIT"):
        env.pop(key, None)
    print(f"THROWAWAY ai-nvim spike · scratch: {root}", flush=True)
    if live:
        print("REAL Drudwyn worktrees · Space o opens CLI · Space t starts task · files persist", flush=True)
    command = [nvim, "-u", str(source / "init.lua"), "-i", "NONE", "--noplugin", *arguments]
    editor = None
    try:
        editor = subprocess.Popen(command, env=env, cwd=root)
        return editor.wait()
    except KeyboardInterrupt:
        if editor and editor.poll() is None:
            editor.terminate()
            try:
                editor.wait(timeout=2)
            except subprocess.TimeoutExpired:
                editor.kill()
                editor.wait()
        return 130
    finally:
        if live:
            from processes import cleanup as cleanup_agents
            cleanup_agents(root)
        else:
            cleanup(root, token)
        shutil.rmtree(root)


if __name__ == "__main__":
    raise SystemExit(main())
