#!/usr/bin/env python3
"""Build pinned editor packages and syntax; optionally register an isolated launcher."""
import argparse
import hashlib
import json
import os
from pathlib import Path
import shutil
import subprocess
import platform
import shlex
import sys
import tempfile
from installer.registration import preflight, register
from installer.sources import export
from installer.syntax import build, host, validate

SOURCE = Path(__file__).resolve().parent / "editor"
APP = "ai-nvim"


def install(cache, compiler):
    raw = (SOURCE / "plugins.lock.json").read_bytes()
    digest = hashlib.sha256(raw).hexdigest()
    data = Path(os.environ.get("XDG_DATA_HOME", Path.home() / ".local/share")) / APP
    releases = data / "releases"
    releases.mkdir(parents=True, exist_ok=True)
    target = releases / digest[:12]
    if (target / ".complete").is_file():
        if (target / ".complete").read_text().strip() != digest:
            raise RuntimeError("Package bundle identity mismatch: " + str(target))
        if (target / ".platform").read_text().strip() != host():
            raise RuntimeError("Package bundle was built for another platform; use a separate XDG_DATA_HOME")
        print("Pinned packages already installed: " + digest[:12])
        return
    if target.exists():
        raise RuntimeError("Incomplete bundle exists; inspect it before retrying: " + str(target))
    with tempfile.TemporaryDirectory(prefix=".install-", dir=releases) as temporary:
        staging = Path(temporary)
        bundle = staging / "bundle"
        spec = json.loads(raw)
        for plugin in spec["plugins"]:
            dest = bundle / "pack" / APP / "opt" / plugin["name"]
            export(plugin["url"], plugin["commit"], dest, staging, cache / plugin["name"] if cache else None)
            print("Installed " + plugin["name"] + " @ " + plugin["commit"][:12], flush=True)
        syntax = bundle / "pack" / APP / "opt" / "syntax"
        build(spec["syntax"], syntax, staging, compiler)
        validate(syntax, spec["syntax"], "nvim", staging)
        docs = sorted(bundle.glob("pack/ai-nvim/opt/*/doc"))
        lua = "for _, p in ipairs({" + ",".join(json.dumps(str(p), ensure_ascii=False) for p in docs) + "}) do vim.cmd('helptags ' .. vim.fn.fnameescape(p)) end"
        env = dict(os.environ, NVIM_APPNAME=APP, NVIM_LOG_FILE=str(staging / "nvim.log"))
        subprocess.run(["nvim", "--headless", "-u", "NONE", "-i", "NONE", "-c", "lua " + lua, "-c", "qa!"], env=env, check=True)
        (bundle / ".platform").write_text(host() + "\n")
        (bundle / ".complete").write_text(digest + "\n")
        bundle.rename(target)
    print("Bundle: " + str(target))


def discover_tools(cache):
    names = ["rust-analyzer", "rustfmt", "lua-language-server", "stylua", "clangd", "vtsls",
             "vscode-html-language-server", "vscode-css-language-server", "vscode-json-language-server",
             "vscode-eslint-language-server", "prettier", "tailwindcss-language-server", "emmet-ls"]
    paths = {}
    for name in names:
        candidates = [cache / "bin" / name, cache / "packages/eslint-lsp/node_modules/.bin" / name] if cache else []
        if shutil.which(name):
            candidates.append(Path(shutil.which(name)))
        for candidate in candidates:
            if candidate.is_file() and os.access(candidate, os.X_OK):
                paths[name] = str(candidate)
                break
    data = Path(os.environ.get("XDG_DATA_HOME", Path.home() / ".local/share")) / APP
    target = data / "tool-paths.json"
    temporary = target.with_suffix(".tmp")
    temporary.write_text(json.dumps(paths, indent=2) + "\n")
    temporary.replace(target)
    print("External tools found (read-only references): " + str(len(paths)) + "/" + str(len(names)))


def prerequisites(compiler):
    if sys.version_info < (3, 12):
        raise RuntimeError("Python 3.12 or newer is required")
    if platform.system() not in ("Darwin", "Linux"):
        raise RuntimeError("Source installation currently supports macOS and Linux")
    command = shlex.split(compiler)
    required = ["git", "nvim", "rg"]
    missing = [name for name in required if not shutil.which(name)]
    if not (shutil.which("fd") or shutil.which("fdfind")):
        missing.append("fd (or fdfind)")
    if not command or not shutil.which(command[0]):
        missing.append("C compiler (install Xcode Command Line Tools or build-essential)")
    if missing:
        raise RuntimeError("Missing prerequisites: " + ", ".join(missing))
    subprocess.run(["nvim", "--headless", "-u", "NONE", "-i", "NONE", "-c",
                    'if !has("nvim-0.11") | cquit 1 | endif', "-c", "qa!"], check=True)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--plugin-cache", type=Path, help="optional local Git repositories containing pinned plugin commits")
    parser.add_argument("--register", action="store_true", help="link the isolated configuration and install the uzume executable (no shell edits)")
    parser.add_argument("--tool-cache", type=Path, help="optional external Mason directory (read-only tool discovery)")
    parser.add_argument("--no-cache", action="store_true", help="ignore supplied plugin/tool caches; fetch pinned sources")
    parser.add_argument("--cc", default=os.environ.get("CC", "cc"), help="C compiler command (default: CC or cc)")
    parser.add_argument("--bin-dir", type=Path, default=Path.home() / ".local/bin", help="launcher directory (default: ~/.local/bin)")
    args = parser.parse_args()
    if args.register:
        preflight(SOURCE, args.bin_dir)
    prerequisites(args.cc)
    install(None if args.no_cache else args.plugin_cache, args.cc)
    discover_tools(None if args.no_cache else args.tool_cache)
    if args.register:
        register(SOURCE, args.bin_dir)
    print("Configuration source: " + str(SOURCE))


if __name__ == "__main__":
    try:
        main()
    except (RuntimeError, OSError, subprocess.SubprocessError) as error:
        print("Uzume installation failed: " + str(error), file=sys.stderr)
        raise SystemExit(1)
